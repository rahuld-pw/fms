# ---------------------------------------------------------------------------
# Campus Ops — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API). For `supabase start`, use the
# values printed by the CLI (API URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser. Used for public endpoints (QR
# reporting, vendor portal), webhooks/outbox and API-key requests.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app; used in emails, QR codes and vendor portal links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile for the anonymous QR issue form. Leave both empty in
# development to disable the captcha (rate limits still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional shared secret for calling internal cron endpoints from an external
# scheduler (pg_cron is used by default).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set KEY=value`
# (not read by the Next.js app)
# ---------------------------------------------------------------------------
# APP_URL=https://ops.yourschool.edu.in
# RESEND_API_KEY=re_...                 # email provider (emails are skipped if unset)
# EMAIL_FROM="Campus Ops <ops@yourschool.edu.in>"
# WHATSAPP_TOKEN=...                    # Meta WhatsApp Cloud API (skipped if unset)
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_LANG=en

# ---------------------------------------------------------------------------
# Tests (see README → Testing)
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_ops_test
# API_BASE=http://localhost:3000/api/v1
